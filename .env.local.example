# 이 파일을 복사해서 .env.local 로 이름을 바꿔 사용하세요.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore 처리되어 커밋되지 않습니다.

# 백엔드 API 베이스 URL (스킴 포함, 끝에 슬래시 없이)
# - 로컬 개발(next dev): 백엔드 주소를 직접 사용(예: http://localhost:8080).
# - Netlify 배포: 백엔드 정식 도메인(https://api.remy-sp.com)에 인증서가 붙어서 직접 호출 가능.
#   Netlify 사이트 설정 > Environment variables 에서 NEXT_PUBLIC_API_BASE_URL=https://api.remy-sp.com
#   으로 지정한다(프록시 redirect 는 더 이상 필요 없음).
NEXT_PUBLIC_API_BASE_URL=https://api.remy-sp.com

# 카카오 개발자 콘솔의 REST API 키. 인가코드 요청(redirect) URL 생성에만 쓰이며
# 브라우저 주소창에 그대로 노출되는 값이라 공개 환경변수로 다뤄도 안전합니다.
# (토큰 교환에 쓰이는 실제 비밀은 백엔드에만 있음)
NEXT_PUBLIC_KAKAO_CLIENT_ID=

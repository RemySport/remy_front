# 이 파일을 복사해서 .env.local 로 이름을 바꿔 사용하세요.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore 처리되어 커밋되지 않습니다.

# 백엔드 API 베이스 URL (스킴 포함, 끝에 슬래시 없이)
# - 로컬 개발(next dev): 백엔드 주소를 직접 사용.
# - Netlify 배포: 반드시 "/api" 로 설정할 것. 백엔드가 아직 평문 HTTP라 브라우저가 직접 호출하면
#   HTTPS 사이트(Netlify)에서 mixed-content로 차단된다. netlify.toml 의 /api/* 리다이렉트가
#   서버 사이드로 대신 호출해준다. Netlify 사이트 설정 > Environment variables 에서
#   NEXT_PUBLIC_API_BASE_URL=/api 로 지정하고(Builds 스코프), 이 .env.local 값과는 다르게 유지한다.
NEXT_PUBLIC_API_BASE_URL=http://13.209.84.103:8080

# 카카오 개발자 콘솔의 REST API 키. 인가코드 요청(redirect) URL 생성에만 쓰이며
# 브라우저 주소창에 그대로 노출되는 값이라 공개 환경변수로 다뤄도 안전합니다.
# (토큰 교환에 쓰이는 실제 비밀은 백엔드에만 있음)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
